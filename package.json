    "dev": "npm run prisma:generate && next dev",
    "build": "npm run prisma:generate && next build",
    "start": "next start",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "seed:default": "node scripts/seed-default-content.mjs",
