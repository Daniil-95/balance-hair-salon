    "framer-motion": "12.23.12",
    "js-cookie": "3.0.7",
    "jsonwebtoken": "9.0.2",
    "next": "^16.3.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "7.84.0",
    "swiper": "12.1.2",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
