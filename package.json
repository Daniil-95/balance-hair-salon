{
  "name": "balance-hair-salon",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "dev": "npm run prisma:generate:dev && next dev",
    "build": "npm run prisma:generate:prod && next build",
    "start": "next start",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "seed:default": "node scripts/seed-default-content.mjs",
    "db:push": "npm run db:push:dev",
    "db:seed": "prisma db seed",
    "db:reset": "npm run db:reset:dev",
    "format": "prettier --write .",
    "prisma:generate": "npm run prisma:generate:dev",
    "prisma:generate:dev": "prisma generate --schema=prisma/schema.dev.prisma",
    "prisma:generate:prod": "dotenv -e .env.production -- prisma generate --schema=prisma/schema.prod.prisma",
    "db:push:dev": "prisma db push --schema=prisma/schema.dev.prisma",
    "db:push:prod": "dotenv -e .env.production -- prisma db push --schema=prisma/schema.prod.prisma",
    "db:reset:dev": "prisma migrate reset --schema=prisma/schema.dev.prisma",
    "prisma:migrate": "prisma migrate dev --name init --schema=prisma/schema.dev.prisma",
    "prepare": "npm run prisma:generate:dev"
  },
  "dependencies": {
    "@fancyapps/ui": "^6.1.14",
    "@prisma/client": "5.11.0",
    "@types/node": "20.17.0",
    "axios": "1.7.9",
    "bcryptjs": "2.4.3",
    "framer-motion": "12.23.12",
    "js-cookie": "3.0.5",
    "jsonwebtoken": "9.0.2",
    "next": "15.3.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "7.84.0",
    "swiper": "11.2.10",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.0",
    "@typescript-eslint/eslint-plugin": "7.10.0",
    "@typescript-eslint/parser": "7.10.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "8.57.0",
    "eslint-config-next": "15.3.3",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-react": "7.33.2",
    "eslint-plugin-react-hooks": "4.6.0",
    "prettier": "3.6.2",
    "prisma": "5.11.0",
    "sass": "1.85.0",
    "tsx": "^4.23.12",
    "typescript": "5.8.2"
  }
}
