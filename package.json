    "db:restore:devdb": "node scripts/restore-devdb-to-postgres.mjs",
    "db:dedupe": "node scripts/dedupe-content.mjs",
    "format": "prettier --write .",
    "prisma:generate": "prisma generate",
    "prisma:pull": "prisma db pull",
    "prisma:migrate": "prisma migrate dev --name init"
  },
  "dependencies": {
    "@fancyapps/ui": "^6.1.14",
    "@prisma/client": "5.11.0",
    "@types/node": "20.17.0",
    "axios": "1.18.0",
