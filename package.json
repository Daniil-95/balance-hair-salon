    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.23",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "3.6.2",
    "prisma": "5.11.0",
    "sass": "1.85.0",
    "sql.js": "^1.13.0",
